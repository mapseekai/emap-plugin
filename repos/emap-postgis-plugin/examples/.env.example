# Copy this file to the plugin root as .env. Server only; never use a VITE_ prefix.
# Use a dedicated SELECT-only, non-administrative database role.
POSTGIS_DATABASE_URL=postgresql://emap_reader:REPLACE_PASSWORD@127.0.0.1:5432/gis
# Generate a random application token; do not reuse the database password.
POSTGIS_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_24_CHARACTERS
POSTGIS_CONNECTION_LABEL=PostGIS
POSTGIS_ALLOWED_ORIGINS=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8787
# For remote databases configure verified TLS using your provider's connection URL.
