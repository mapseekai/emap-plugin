{
  "description": "Shared JS PostgreSQL 18 / Rust PostgreSQL 17 policy subset; not a full grammar compatibility claim. Accepted cases execute against the disposable parity database.",
  "cases": [
    { "name": "single select", "sql": "SELECT 1 AS id", "rows": [{"id":1}] },
    { "name": "comment and bound text", "sql": "/* comment */ SELECT $1::text AS name;", "parameters": ["中文'; DROP TABLE shapes; --"], "rows": [{"name":"中文'; DROP TABLE shapes; --"}] },
    { "name": "SQL words in literal", "sql": "SELECT 'delete; drop table shapes' AS label", "rows": [{"label":"delete; drop table shapes"}] },
    { "name": "read CTE", "sql": "WITH x AS (SELECT 1 AS id) SELECT * FROM x", "rows": [{"id":1}] },
    { "name": "CTE JOIN params", "sql": "WITH x AS (SELECT $1::int AS id) SELECT x.id FROM x JOIN (SELECT $2::int AS id) y ON x.id=y.id", "parameters": [7,7], "rows": [{"id":7}] },
    { "name": "spatial function", "sql": "SELECT ST_Intersects(ST_SetSRID(ST_MakePoint(2,3),4326),ST_MakeEnvelope(1,2,3,4,4326)) AS hit", "rows": [{"hit":true}] },
    { "name": "union", "sql": "SELECT 1 AS id UNION ALL SELECT 2 ORDER BY id", "rows": [{"id":1},{"id":2}] },
    { "name": "quoted keyword and escaped identifier", "sql": "SELECT 1 AS \"delete\", 2 AS \"a\"\"b\", 3 AS \"pg_sleep\"", "rows": [{"delete":1,"a\"b":2,"pg_sleep":3}] },
    { "name": "quoted function-looking column", "sql": "SELECT x.\"set_config\" FROM (SELECT 1 AS \"set_config\") x", "rows": [{"set_config":1}] },
    { "name": "empty", "sql": "", "error": "INVALID_SQL" },
    { "name": "whitespace", "sql": " \n\t ", "error": "INVALID_SQL" },
    { "name": "invalid syntax", "sql": "SELECT FROM", "error": "INVALID_SQL" },
    { "name": "multiple statements", "sql": "SELECT 1; SELECT 2", "error": "SELECT_ONLY" },
    { "name": "delete", "sql": "DELETE FROM shapes", "error": "SELECT_ONLY" },
    { "name": "insert", "sql": "INSERT INTO shapes(id) VALUES (9)", "error": "SELECT_ONLY" },
    { "name": "update", "sql": "UPDATE shapes SET name='x'", "error": "SELECT_ONLY" },
    { "name": "ddl", "sql": "DROP TABLE shapes", "error": "SELECT_ONLY" },
    { "name": "copy", "sql": "COPY shapes TO STDOUT", "error": "SELECT_ONLY" },
    { "name": "explain", "sql": "EXPLAIN SELECT 1", "error": "SELECT_ONLY" },
    { "name": "write CTE delete", "sql": "WITH changed AS (DELETE FROM shapes RETURNING *) SELECT * FROM changed", "error": "SELECT_ONLY" },
    { "name": "write CTE insert", "sql": "WITH changed AS (INSERT INTO shapes(id) VALUES (9) RETURNING id) SELECT * FROM changed", "error": "SELECT_ONLY" },
    { "name": "write CTE update", "sql": "WITH changed AS (UPDATE shapes SET name='x' RETURNING id) SELECT * FROM changed", "error": "SELECT_ONLY" },
    { "name": "select into", "sql": "SELECT * INTO copied FROM shapes", "error": "SELECT_ONLY" },
    { "name": "nested select into", "sql": "WITH q AS (SELECT * INTO copied FROM shapes) SELECT * FROM q", "error": "SELECT_ONLY" },
    { "name": "for update", "sql": "SELECT * FROM shapes FOR UPDATE", "error": "SELECT_ONLY" },
    { "name": "for share", "sql": "SELECT * FROM shapes FOR SHARE", "error": "SELECT_ONLY" },
    { "name": "nested locking", "sql": "SELECT * FROM (SELECT * FROM shapes FOR KEY SHARE) q", "error": "SELECT_ONLY" },
    { "name": "session mutation", "sql": "SELECT set_config('transaction_read_only','off',true)", "error": "UNSAFE_FUNCTION" },
    { "name": "qualified session function", "sql": "SELECT pg_catalog.set_config('search_path','evil',false)", "error": "UNSAFE_FUNCTION" },
    { "name": "quoted case folded function", "sql": "SELECT pg_catalog.\"SET_CONFIG\"('search_path','evil',false)", "error": "UNSAFE_FUNCTION" },
    { "name": "sequence next", "sql": "SELECT nextval('x')", "error": "UNSAFE_FUNCTION" },
    { "name": "sequence set", "sql": "SELECT setval('x',1)", "error": "UNSAFE_FUNCTION" },
    { "name": "administrative function", "sql": "SELECT pg_sleep(1)", "error": "UNSAFE_FUNCTION" },
    { "name": "dblink", "sql": "SELECT dblink('x','SELECT 1')", "error": "UNSAFE_FUNCTION" },
    { "name": "dblink prefix quoted", "sql": "SELECT \"custom\".\"DBLINK_connect\"('x')", "error": "UNSAFE_FUNCTION" },
    { "name": "nested disabled function", "sql": "WITH q AS (SELECT pg_catalog.pg_sleep(1)) SELECT * FROM q", "error": "UNSAFE_FUNCTION" }
  ]
}
