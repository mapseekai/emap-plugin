{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "declaration": true, "outDir": "dist",
    "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["src", "test/**/*.ts"]
}
