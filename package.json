{
  "name": "emap-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "bootstrap": "node scripts/repos.mjs install",
    "build": "node scripts/repos.mjs build",
    "management:test": "node --test test/*.test.mjs",
    "management:verify": "npm run management:test",
    "test": "npm run management:test && node scripts/repos.mjs test",
    "verify": "npm run management:verify && node scripts/repos.mjs verify",
    "verify:all": "npm run management:verify && node scripts/repos.mjs verify:all && npm --prefix apps/postgis-connector run verify:all",
    "new:plugin": "node scripts/new-plugin.mjs",
    "connector:verify": "npm --prefix apps/postgis-connector run verify",
    "connector:dev": "npm --prefix apps/postgis-connector run dev",
    "connector:build": "npm --prefix apps/postgis-connector run build:native"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.10",
    "typescript": "5.9.3"
  }
}
